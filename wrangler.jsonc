// Cloudflare Workers: the site is served as static files from public/. Each push to main builds and deploys it.
{
  // Must match the Worker's name in the Cloudflare dashboard, or the build fails.
  "name": "moderngtm-ai",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./public"
  },
  // The site answers at moderngtm.ai and www.moderngtm.ai only; the workers.dev address is off.
  "workers_dev": false,
  // Version preview addresses are not used.
  "preview_urls": false
}
